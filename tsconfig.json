{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@tarve/core",
    "types": [
      "bun",
      "@tarve/core/assets"
    ]
  },
  "include": [
    "app",
    "scripts"
  ]
}
