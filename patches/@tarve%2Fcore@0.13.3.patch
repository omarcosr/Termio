+    emitLibrary = txikiFfi.dlopen(path, definitions);
+    address = emitLibrary.symbols.tarve_plugin_emit_address();
+  } else if (process.versions.bun) {
+    emitLibrary = require2("bun:ffi").dlopen(path, definitions);
+    address = emitLibrary.symbols.tarve_plugin_emit_address();
+  }
   else {
     const { dlopen } = require2("node:ffi");
     address = dlopen(path, { tarve_plugin_emit_address: { arguments: [], return: "uint64" } }).functions.tarve_plugin_emit_address();
